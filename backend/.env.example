# Copy to backend/.env. Never commit backend/.env.
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=20
UPLOAD_DIR=uploads
REPORT_DIR=reports

# Gemini is called only from the backend. Never use NEXT_PUBLIC_ for secrets.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Supabase live persistence is not connected in the current milestone.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
