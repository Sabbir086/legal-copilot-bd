# Copy to backend/.env. Never commit backend/.env.
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=20
UPLOAD_DIR=uploads
REPORT_DIR=reports

# OpenRouter is called only from the backend. Never use NEXT_PUBLIC_ for secrets.
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000

# Required for M1 conversation history and private attachment storage.
# Keep both values on the backend only; never add them to frontend/.env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_secret_or_service_role_key
MAX_CONVERSATION_ATTACHMENTS=8
MAX_CHAT_CONTEXT_CHARS=90000

# M2 document processing safety and OCR settings (no secret values)
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_UPLOAD_MB=8
MAX_PDF_PAGES=500
OCR_LANGUAGES=ben+eng
TESSERACT_CMD=tesseract
OCR_DPI=200
OCR_MIN_TEXT_CHARS=30
DOCUMENT_SEGMENT_CHARS=6000
DOCUMENT_SEGMENT_OVERLAP_CHARS=300
DOCUMENT_WORKER_POLL_SECONDS=5
MAX_DOCUMENT_RESPONSE_TEXT_CHARS=12000
