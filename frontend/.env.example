# Public API base URL only. Never put Gemini or Supabase service-role secrets here.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public Supabase Auth values only (safe for browser usage).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_supabase_anon_or_publishable_key
